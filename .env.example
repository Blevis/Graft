# Copy to .env for local runs. Never commit .env. Secrets stay empty here.

# sqlite for local dev/tests; docker-compose overrides this with its Postgres container.
DATABASE_URL=sqlite:///./graft.db
AUTH_MODE=demo
DEMO_MODE=true
AS_OF_DATE=2026-10-14
SESSION_SECRET=

GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
