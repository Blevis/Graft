# Copy to .env (demo) or .env.private (private profile). Never commit either. Secrets stay empty here.

# sqlite for local dev/tests; docker-compose overrides this with its Postgres container.
DATABASE_URL=sqlite:///./graft.db
AUTH_MODE=demo
DEMO_MODE=true
AS_OF_DATE=2026-10-14
SESSION_SECRET=
SESSION_HOURS=8

# Private inference (Ollama). Leave OLLAMA_BASE_URL empty to run without a model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ALLOWED_HOSTS=127.0.0.1,localhost,::1,ollama
# Only when the model is reached through the token gateway (python -m app.gateway) over a tunnel. Never commit it.
OLLAMA_API_KEY=
LLM_MODEL=qwen3:8b
LLM_ALLOWED_MODELS=qwen3:8b,gpt-oss:20b
# Pin the exact weights: `python -m app.ops model-status` prints the digest to copy here.
LLM_MODEL_DIGEST=
LLM_TIMEOUT_SECONDS=120
LLM_CONTEXT_TOKENS=16384
LLM_MAX_CONCURRENCY=1
LLM_THINK=false
AGENT_MAX_SECONDS=180
ANALYSIS_WORKER=thread
AI_DEBUG_CAPTURE=false

# Production identity (AUTH_MODE=oidc, DEMO_MODE=false). See docs/deployment.md.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ORG_SLUG=
OIDC_GROUP_ROLE_MAP=

# Private compose profile only
POSTGRES_PASSWORD=
OLLAMA_VERSION=
